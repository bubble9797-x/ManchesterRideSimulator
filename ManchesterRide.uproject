{
	"FileVersion": 3,
	"EngineAssociation": "5.5",
	"Category": "",
	"Description": "Manchester Riding Simulator - open-world multiplayer riding simulator set in Greater Manchester.",
	"Modules": [
		{
			"Name": "ManchesterRide",
			"Type": "Runtime",
